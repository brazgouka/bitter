# --- General ---
ENVIRONMENT=development
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# --- Database ---
# Local dev default is SQLite (no config needed). For Postgres:
# DATABASE_URL=postgresql+psycopg://bitter:bitter@localhost:5432/bitter
DATABASE_URL=sqlite:///./bitter.db

# --- Security ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-to-a-long-random-string
# Optional. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY=

# --- GitHub OAuth ---
# Create an OAuth app at https://github.com/settings/developers
# Authorization callback URL: http://localhost:8000/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# For CLI testing (scripts/run_real.py) without the OAuth browser flow.
# A GitHub personal access token: https://github.com/settings/tokens
# Public repos need no scope; private repos need the 'repo' scope.
GITHUB_TOKEN=

# --- GitLab ---
# No app registration needed. Users connect their own GitLab account from the
# Settings page by pasting a personal access token (scopes: read_api,
# write_repository): https://gitlab.com/-/user_settings/personal_access_tokens
# Override for a self-hosted GitLab instance:
# GITLAB_API_BASE=https://gitlab.example.com/api/v4

# --- Anthropic (Claude advisor) ---
# Without a key, the advisor uses a deterministic heuristic fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Advisor backend ---
# auto | claude | local | heuristic
#   auto      = Claude if ANTHROPIC_API_KEY set, else heuristic
#   local     = free local LLM via an OpenAI-compatible server (Ollama, LM Studio)
#   heuristic = deterministic, no LLM
ADVISOR_BACKEND=auto
# For ADVISOR_BACKEND=local. Install Ollama (https://ollama.com), then:
#   ollama pull llama3.1  &&  ollama serve
LOCAL_MODEL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=llama3.1
LOCAL_MODEL_API_KEY=ollama

# --- Email delivery ---
# console = print digests to stdout (default); smtp = send via SMTP.
EMAIL_BACKEND=console
EMAIL_FROM=Bitter <no-reply@bitter.dev>
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false

# --- Scheduler ---
ENABLE_SCHEDULER=true
DAILY_RUN_HOUR=7
DAILY_RUN_MINUTE=0
